FROM ghcr.io/rocker-org/devcontainer/r-ver:4.5

# Architecture-specific variable (built in Docker BuildKit)
ARG TARGETARCH

# Install quarto-cli and the orange-book extension
RUN wget https://github.com/quarto-dev/quarto-cli/releases/download/v1.9.35/quarto-1.9.35-linux-${TARGETARCH}.deb && \
    dpkg -i quarto-1.9.35-linux-${TARGETARCH}.deb && \
    rm quarto-1.9.35-linux-${TARGETARCH}.deb

# Adding R packages
RUN install2.r --error data.table quarto ggplot2 rvest remotes tinytest

# Pinned versions for the data in data/utaz_data.R: socialmixr from CRAN and
# multigroup.vaccine from GitHub (the 2024 census data and the Utah/Arizona
# border vignette are not in a CRAN release yet).
RUN Rscript -e 'remotes::install_version("socialmixr", version = "0.7.0", upgrade = "never")' && \
    Rscript -e 'remotes::install_github("EpiForeSITE/multigroup-vaccine@ddd9201f28b9908c033542f6a2445b84619af1c7", upgrade = "never")' && \
    Rscript -e 'stopifnot(packageVersion("socialmixr") == "0.7.0", file.exists(system.file("extdata", "hildale_ut_2024.csv", package = "multigroup.vaccine")))'

# epiworldR and measles pinned to the commits of the outputs in scenarios/
# (Figure 4, run on 2026-10-09): epiworldR 0.19.0 with clone_epi() and measles
# 0.4.1 with geometric stage durations. Development builds change results
# without a version bump (measles 0.4.1 after UofUEpiBio/measles#69 has
# lognormal stage durations), so the version alone does not identify them.
RUN Rscript -e 'remotes::install_github("UofUEpiBio/epiworldR@ce1cb0f088b9a3a19674fb6598b2c42780c72b12", upgrade = "never", dependencies = FALSE)' && \
    Rscript -e 'remotes::install_github("UofUEpiBio/measles@d1e87fed204ebe820620759fa1b85cdb9d2e0b03", upgrade = "never", dependencies = FALSE)' && \
    Rscript -e 'stopifnot(packageDescription("epiworldR")$RemoteSha == "ce1cb0f088b9a3a19674fb6598b2c42780c72b12", packageDescription("measles")$RemoteSha == "d1e87fed204ebe820620759fa1b85cdb9d2e0b03")'

CMD ["bash"]
